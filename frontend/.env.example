# Dashboard configuration
# Leave VITE_DEMO_MODE unset (or true) to run against the bundled
# two-week simulation and deploy with no backend.
VITE_DEMO_MODE=true

# Set these only when running against the live backend:
# VITE_DEMO_MODE=false
# VITE_API_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000
