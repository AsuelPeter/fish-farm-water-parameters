@startuml Use Case Diagram
!theme plain
title IoT-Based Automated Water Regulation for Fish Farming - Use Case Diagram

left to right direction
skinparam packageStyle rectangle

actor "Fish Farmer" as Farmer
actor "System Admin" as Admin
actor "ESP32 Device" as Device
actor "MQTT Broker" as MQTT

rectangle "Fish Farm IoT System" {
    usecase "Monitor Water Parameters" as UC1
    usecase "View Real-time Dashboard" as UC2
    usecase "Receive Alert Notifications" as UC3
    usecase "Control Actuators Remotely" as UC4
    usecase "Set Threshold Parameters" as UC5
    usecase "View Historical Data" as UC6
    usecase "Manage Fish Ponds" as UC7
    usecase "Configure Device Settings" as UC8
    usecase "Acknowledge Alerts" as UC9
    usecase "Schedule Feeding" as UC10
    usecase "Manage User Accounts" as UC11
    usecase "Export Data Reports" as UC12
    usecase "Acquire Sensor Data" as UC13
    usecase "Control Water Pump" as UC14
    usecase "Control Aerator" as UC15
    usecase "Control Heater" as UC16
    usecase "Control Valves" as UC17
    usecase "Publish Sensor Data" as UC18
    usecase "Receive Commands" as UC19
    usecase "Store Time-Series Data" as UC20
    usecase "Process Alert Rules" as UC21
}

Farmer -- UC1
Farmer -- UC2
Farmer -- UC3
Farmer -- UC4
Farmer -- UC5
Farmer -- UC6
Farmer -- UC9
Farmer -- UC10
Farmer -- UC12

Admin -- UC7
Admin -- UC8
Admin -- UC11

Device -- UC13
Device -- UC14
Device -- UC15
Device -- UC16
Device -- UC17
Device -- UC18
Device -- UC19

MQTT -- UC20
MQTT -- UC21

UC1 ..> UC13 : <<include>>
UC2 ..> UC1 : <<include>>
UC4 ..> UC19 : <<include>>
UC3 ..> UC21 : <<include>>
UC14 ..> UC15 : <<extend>>
UC16 ..> UC17 : <<extend>>

@enduml
